@using ShowTracker.Data.Models
@using System.Security.Claims
@model Show

@{
    ViewBag.Title = "Show";
}

@{
    Guid userId = Guid.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!);
    bool userIsAdmin = User.IsInRole("Admin");
}

<link rel="stylesheet" href="~/css/show.css" />

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="container">

    <!-- HEADER -->
    <div class="show-header">
        @{
            string imageUrl = null;
            string? image = Directory.GetFiles("wwwroot/ShowPics/", $"{Model.Name.ToLower()}{Model.Id.ToString()}.jpg").FirstOrDefault();

            if (image != null)
            {
                imageUrl = image.Replace("wwwroot", "").Replace("\\", "/");
            }
        }

        <img src="@(imageUrl ?? "/images/no-image.png")" class="poster" alt="@Model.Name" />

        <div class="show-info">
            <h1>@Model.Name</h1>

            <div class="genre-list">
                @foreach (var genre in Model.Genres)
                {
                    <span class="genre-badge">@genre.Genre.Name</span>
                }
            </div>

            <p>@Model.Description</p>

            @if (Model.Users.Any(u => u.UserId == userId))
            {
                <a class="follow-btn"
                       asp-controller="Show"
                       asp-action="FollowShow"
                       asp-route-id="@Model.Id">
                    Unfollow
                </a>
            }
            else
            {
                <a class="follow-btn"
                       asp-controller="Show"
                       asp-action="FollowShow"
                       asp-route-id="@Model.Id">
                    Follow
                </a>
            }
        </div>
    </div>

    <!-- SEASONS -->
    <div class="season-posters">

        @for (int i = 1; i <= Model.Seasons.Count(); i++)
        {
            <a asp-controller="Show"
               asp-action="Index"
               asp-route-id="@Model.Id"
               asp-route-seasonNumber="@i"
               class="season-btn">
                Season @i
            </a>
        }

    </div>

    <!-- CURRENT SEASON -->
    @{
        int a = ViewBag.SeasonNumber;
        Season? currentSeason = Model.Seasons.FirstOrDefault(s => s.SeasonNumber == a);
    }

    <div class="episodes">
        <h2>Season @currentSeason.SeasonNumber</h2>

        <div class="episode-grid">
            @{
                Episode[] episodes = currentSeason.Episodes.ToArray();

                @for (int i = 0; i < episodes.Count(); i++)
                {
                    var currentEpisode = episodes[i];

                    <div class="episode-card">
                        <img src="@currentEpisode.ImageUrl" />

                        <div class="episode-info">
                            <span>
                                @currentSeason.SeasonNumber x @((i + 1).ToString("00"))
                            </span>
                            <p>@episodes[i].EpisodeTitle</p>
                            <p>
                                <small>@currentEpisode.ReleaseDate.ToString("dd-MM-yyyy")</small>
                            </p>
                        </div>

                        @if (!currentEpisode.Users.Any(u => u.UserId == userId))
                        {
                            <form asp-action="EpisodeWatched"
                                  asp-controller="Episode"
                                  class="watched-btn">
                                <input type="hidden" name="id" value="@currentEpisode.Id" />
                                <input type="hidden" name="showId" value="@Model.Id" />
                                <input type="hidden" name="seasonNumber" value="@currentSeason.SeasonNumber" />

                                <button type="submit">Watched</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="EpisodeWatched"
                                  asp-controller="Episode"
                                  class="unwatched-btn">
                                <input type="hidden" name="id" value="@currentEpisode.Id" />
                                <input type="hidden" name="showId" value="@Model.Id" />
                                <input type="hidden" name="seasonNumber" value="@currentSeason.SeasonNumber" />

                                <button type="submit">Unwatched</button>
                            </form>
                        }

                    </div>
                }
            }