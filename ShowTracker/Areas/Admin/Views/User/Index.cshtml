@using ShowTracker.ViewModel.Admin
@model IEnumerable<UsersAndRolesViewModel>

@{
    ViewData["Title"] = "User Management";
    var allRoles = ViewBag.AllRoles as string[];
}

<h2 class="page-title">User Management</h2>

<div class="table-container">
    <table class="table table-bordered table-striped user-table">
        <thead>
            <tr>
                <th>Email</th>
                <th>Role</th>
                <th style="width: 220px;">Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <form asp-action="UpdateUserRole" method="post">
                        <td class="email-cell">
                            @user.Email
                            <input type="hidden" name="Id" value="@user.Id" />
                        </td>

                        <td>
                            <select name="Role" class="form-select role-select">
                                @foreach (var role in allRoles)
                                {
                                        <option value="@role"
                                                selected="@(user.Roles.Contains(role) ? "selected" : null)">
                                        @role
                                        </option>
                                }
                            </select>
                        </td>

                        <td class="actions-cell">
                            <button type="submit" class="btn btn-success btn-sm action-btn">
                                Update role
                            </button>

                            <a asp-action="DeleteUser"
                               asp-route-id="@user.Id"
                               class="btn btn-danger btn-sm action-btn"
                               onclick="return confirm('Delete this user?');">
                                Delete user
                            </a>
                        </td>
                    </form>
                </tr>
            }
        </tbody>
    </table>
</div>