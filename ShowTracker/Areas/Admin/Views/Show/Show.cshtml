@using ShowTracker.Data.Models
@using System.Security.Claims
@model Show

@{
    ViewBag.Title = "Show";
}

@{
    Guid userId = Guid.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!);
}

<link rel="stylesheet" href="~/css/show.css" />

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="container">

    <!-- HEADER -->
    <div class="show-header">
        @{
            string imageUrl = null;
            string? image = Directory.GetFiles("wwwroot/ShowPics/", $"{Model.Name.ToLower()}{Model.Id.ToString()}.jpg").FirstOrDefault();

            if (image != null)
            {
                imageUrl = image.Replace("wwwroot", "").Replace("\\", "/");
            }
        }

        <img src="@(imageUrl ?? "/images/no-image.png")" class="poster" alt="@Model.Name" />

        <div class="show-info">
            <h1>@Model.Name</h1>
            <p>@Model.Description</p>

                <a asp-area="Admin"
                   asp-controller="Show"
                   asp-action="EditShow"
                   asp-route-id="@Model.Id"
                   class="edit-btn">
                    Edit show
                </a>

                <a asp-area="Admin"
                   asp-controller="Delete"
                   asp-action="Show"
                   asp-route-id="@Model.Id"
                   class="delete-btn">
                    Delete show
                </a>
        </div>
    </div>

    <!-- SEASONS -->
    <div class="season-posters">

            <a asp-area="Admin"
               asp-controller="Season"
               asp-action="CreateSeason"
               asp-route-id="@Model.Id"
               asp-route-count="1"
               class="addseason-btn">
                Add season
            </a>

        @for (int i = 1; i <= Model.Seasons.Count(); i++)
        {
            <a asp-area="Admin"
               asp-controller="Show"
               asp-action="Show"
               asp-route-id="@Model.Id"
               asp-route-seasonNumber="@i"
               class="season-btn">
                Season @i
            </a>
        }
            <a asp-area="Admin"
               asp-controller="Season"
               asp-action="DeleteSeason"
               asp-route-id="@Model.Id"
               asp-route-count="1"
               class="removeseason-btn">
                Remove season
            </a>
    </div>

    <!-- CURRENT SEASON -->
    @{
        int a = ViewBag.SeasonNumber;
        Season? currentSeason = Model.Seasons.FirstOrDefault(s => s.SeasonNumber == a);
    }

    <div class="episodes">
        <h2>Season @currentSeason.SeasonNumber</h2>

            <div class="episode-actions">
                <a asp-area="Admin"
                   asp-controller="Episode"
                   asp-action="AddNewEpisode"
                   asp-route-id="@currentSeason.Id"
                   class="addseason-btn">
                    + Add New Episode
                </a>
            </div>
        <div class="episode-grid">
            @{
                Episode[] episodes = currentSeason.Episodes.ToArray();

                @for (int i = 0; i < episodes.Count(); i++)
                {
                    var currentEpisode = episodes[i];

                    <div class="episode-card">
                        <img src="@currentEpisode.ImageUrl" />

                        <div class="episode-info">
                            <span>
                                @currentSeason.SeasonNumber x @((i + 1).ToString("00"))
                            </span>
                            <p>@episodes[i].EpisodeTitle</p>
                            <p>
                                <small>@currentEpisode.ReleaseDate.ToString("dd-MM-yyyy")</small>
                            </p>
                        </div>

                            <a asp-area="Admin"
                               asp-controller="Episode"
                               asp-action="EditEpisode"
                               asp-route-id="@currentEpisode.Id"
                               class="edit-episode-btn">
                                Edit episode
                            </a>

                            <a asp-area="Admin"
                               asp-controller="Delete"
                               asp-action="Episode"
                               asp-route-id="@currentEpisode.Id"
                               class="remove-episode-btn">
                                Remove episode
                            </a>
                        }
                    </div>
                }}